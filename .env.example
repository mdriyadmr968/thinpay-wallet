# Application
NEXT_PUBLIC_APP_NAME="ThinPay Wallet"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT="testnet"

# Backend API Endpoints (web3service-node)
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:5000/graphql"

# Web3 & WalletConnect (Obtain free at cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"

# Supported Testnet RPC Endpoints
NEXT_PUBLIC_SEPOLIA_RPC="https://rpc.sepolia.org"
NEXT_PUBLIC_POLYGON_AMOY_RPC="https://rpc-amoy.polygon.technology"
NEXT_PUBLIC_BSC_TESTNET_RPC="https://data-seed-prebsc-1-s1.binance.org:8545"
NEXT_PUBLIC_BASE_SEPOLIA_RPC="https://sepolia.base.org"
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"
NEXT_PUBLIC_SOLANA_DEVNET_RPC="https://api.devnet.solana.com"

# Block Explorers (Testnets)
NEXT_PUBLIC_EXPLORER_SEPOLIA="https://sepolia.etherscan.io"
NEXT_PUBLIC_EXPLORER_AMOY="https://amoy.polygonscan.com"
NEXT_PUBLIC_EXPLORER_BSC_TESTNET="https://testnet.bscscan.com"
NEXT_PUBLIC_EXPLORER_BASE_SEPOLIA="https://sepolia.basescan.org"
NEXT_PUBLIC_EXPLORER_ARBITRUM_SEPOLIA="https://sepolia.arbiscan.io"
NEXT_PUBLIC_EXPLORER_SOLANA_DEVNET="https://explorer.solana.com/?cluster=devnet"

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_COPILOT="true"
